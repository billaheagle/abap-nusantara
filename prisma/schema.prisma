// ABAP Nusantara — database schema
// Postgres + Prisma. See README for indexing rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

// Admins are never created through the app. Seeded from ADMIN_EMAILS +
// ADMIN_PASSWORD_HASHES env vars. See getAdminCredentials() in src/lib/env.ts.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

model Series {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  coverImage  String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([order])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  // Tiptap structured content, stored as JSON — never raw trusted HTML.
  contentJson   Json
  coverImage    String?
  repoUrl       String?
  status        ArticleStatus @default(DRAFT)
  readingTimeMin Int          @default(1)

  seriesId      String?
  series        Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder   Int?

  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags          ArticleTag[]
  comments      Comment[]
  likes         Like[]
  views         ArticleViewDaily[]
  media         Media[]

  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([seriesId, seriesOrder])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Comment {
  id              String        @id @default(cuid())
  articleId       String
  article         Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parent          Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")

  authorName      String
  authorEmail     String // never displayed publicly
  body            String        @db.VarChar(2000)
  status          CommentStatus @default(PENDING)

  ipHash          String? // hashed, not raw IP
  createdAt       DateTime      @default(now())

  @@index([articleId, status])
  @@index([parentCommentId])
}

model Like {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // hash of an anonymous visitor cookie value, not the raw cookie
  anonHash  String
  createdAt DateTime @default(now())

  @@unique([articleId, anonHash])
  @@index([articleId])
}

// Page views, pre-aggregated per article per day (Asia/Jakarta calendar day).
// One row per (article, day) keeps the table tiny and stores nothing about
// individual visitors — no IP, no cookie, no user agent.
model ArticleViewDaily {
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@id([articleId, day])
  @@index([day])
}

// Admin-editable site copy (landing page, about, footer, hire-me). One row per
// section, keyed by name; the JSON shape is validated by the zod schemas in
// src/features/settings/schema.ts, which also hold the defaults used when a
// row is missing.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  url       String
  alt       String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}
